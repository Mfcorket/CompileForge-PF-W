<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListCell?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.pythonforge.controller.PythonEnvironmentController"
            styleClass="python-environment-root">

    <top>

        <VBox spacing="8">

            <Label text="Python Environment"
                   styleClass="environment-title"/>

            <Label text="Detected Python Environments"
                   styleClass="environment-subtitle"/>

            <Separator/>

        </VBox>

    </top>

    <center>

        <ListView fx:id="environmentList"
                  VBox.vgrow="ALWAYS"/>

    </center>

    <bottom>

        <VBox spacing="10">

            <Separator/>

            <Label text="Selected Environment"
                   styleClass="environment-section-title"/>

            <VBox spacing="5"
                  styleClass="selected-environment">

                <Label fx:id="selectedVersionLabel"
                       text="No environment selected"
                       styleClass="selected-version"/>

                <Label fx:id="selectedPathLabel"
                       text=""
                       wrapText="true"
                       styleClass="selected-path"/>

                <HBox spacing="20">

                    <Label fx:id="selectedArchitectureLabel"
                           text="Architecture: -"/>

                    <Label fx:id="selectedPipLabel"
                           text="pip: -"/>

                    <Label fx:id="selectedPyInstallerLabel"
                           text="PyInstaller: -"/>

                </HBox>

            </VBox>

            <HBox spacing="10">

                <Button fx:id="refreshButton"
                        text="Refresh"/>

                <HBox HBox.hgrow="ALWAYS"/>

                <Button fx:id="useButton"
                        text="Use This Python"
                        disable="true"/>

                <Button fx:id="closeButton"
                        text="Close"/>

            </HBox>

        </VBox>

    </bottom>

    <padding>
        <Insets top="15"
                right="15"
                bottom="15"
                left="15"/>
    </padding>

</BorderPane>