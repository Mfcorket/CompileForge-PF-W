<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<VBox spacing="10"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.pythonforge.controller.HistoryController">


    <padding>
        <Insets top="10"
                right="10"
                bottom="10"
                left="10"/>
    </padding>


    <!-- 搜索区域 -->
    <HBox spacing="10">

        <Label text="搜索:"/>

        <TextField fx:id="searchField"
                   promptText="输入应用名称或路径"/>

    </HBox>



    <TableView fx:id="historyTable"
               prefHeight="420">


        <columns>


            <TableColumn fx:id="timeColumn"
                         text="时间"
                         prefWidth="150"/>


            <TableColumn fx:id="nameColumn"
                         text="应用名称"
                         prefWidth="130"/>


            <TableColumn fx:id="pythonColumn"
                         text="Python版本"
                         prefWidth="100"/>


            <TableColumn fx:id="statusColumn"
                         text="状态"
                         prefWidth="90"/>


            <TableColumn fx:id="outputColumn"
                         text="输出文件"
                         prefWidth="320"/>

            <TableColumn fx:id="logColumn"
                         text="日志"
                         prefWidth="120"/>


        </columns>


    </TableView>



    <HBox spacing="10">


        <Button text="清空历史"
                onAction="#handleClear"/>


        <Button text="关闭"
                onAction="#handleClose"/>


    </HBox>


</VBox>