<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ColorPicker?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.pythonforge.controller.ThemeSettingsController">

    <top>

        <VBox spacing="6">

            <padding>

                <Insets
                        top="18"
                        right="20"
                        bottom="12"
                        left="20"/>

            </padding>

            <Label
                    text="主题设置"
                    styleClass="workspace-title"/>

            <Label
                    text="选择 PythonForge-win 的界面主题。"/>

        </VBox>

    </top>


    <center>

        <VBox
                spacing="15">

            <padding>

                <Insets
                        top="10"
                        right="20"
                        bottom="10"
                        left="20"/>

            </padding>


            <Label
                    text="主题模式"
                    styleClass="panel-title"/>


            <ComboBox
                    fx:id="themeTypeComboBox"
                    prefWidth="300"/>


            <Separator/>


            <Label
                    text="自定义颜色"
                    styleClass="panel-title"/>


            <GridPane
                    hgap="12"
                    vgap="10">


                <Label
                        text="背景颜色"
                        GridPane.rowIndex="0"
                        GridPane.columnIndex="0"/>

                <ColorPicker
                        fx:id="backgroundColorPicker"
                        GridPane.rowIndex="0"
                        GridPane.columnIndex="1"/>


                <Label
                        text="面板颜色"
                        GridPane.rowIndex="1"
                        GridPane.columnIndex="0"/>

                <ColorPicker
                        fx:id="panelColorPicker"
                        GridPane.rowIndex="1"
                        GridPane.columnIndex="1"/>


                <Label
                        text="文字颜色"
                        GridPane.rowIndex="2"
                        GridPane.columnIndex="0"/>

                <ColorPicker
                        fx:id="textColorPicker"
                        GridPane.rowIndex="2"
                        GridPane.columnIndex="1"/>


                <Label
                        text="次要文字"
                        GridPane.rowIndex="3"
                        GridPane.columnIndex="0"/>

                <ColorPicker
                        fx:id="secondaryTextColorPicker"
                        GridPane.rowIndex="3"
                        GridPane.columnIndex="1"/>


                <Label
                        text="边框颜色"
                        GridPane.rowIndex="4"
                        GridPane.columnIndex="0"/>

                <ColorPicker
                        fx:id="borderColorPicker"
                        GridPane.rowIndex="4"
                        GridPane.columnIndex="1"/>


                <Label
                        text="强调颜色"
                        GridPane.rowIndex="5"
                        GridPane.columnIndex="0"/>

                <ColorPicker
                        fx:id="accentColorPicker"
                        GridPane.rowIndex="5"
                        GridPane.columnIndex="1"/>

            </GridPane>


            <Separator/>


            <Label
                    text="背景图片"
                    styleClass="panel-title"/>


            <HBox
                    spacing="8">

                <TextField
                        fx:id="backgroundImageField"
                        promptText="选择 PNG / JPG / GIF 图片"
                        editable="false"
                        HBox.hgrow="ALWAYS"/>

                <Button
                        text="浏览..."
                        onAction="#handleSelectBackgroundImage"/>

                <Button
                        text="清除"
                        onAction="#handleClearBackgroundImage"/>

            </HBox>


            <Label
                    fx:id="statusLabel"
                    text="当前使用：自动"/>

        </VBox>

    </center>


    <bottom>

        <HBox
                spacing="10"
                alignment="CENTER_RIGHT">

            <padding>

                <Insets
                        top="10"
                        right="20"
                        bottom="20"
                        left="20"/>

            </padding>


            <Button
                    text="恢复默认"
                    onAction="#handleReset"/>


            <Button
                    text="取消"
                    onAction="#handleCancel"/>


            <Button
                    text="保存"
                    styleClass="primary-button"
                    onAction="#handleSave"/>

        </HBox>

    </bottom>

</BorderPane>